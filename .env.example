# NodePoolME environment file. Copy to .env and edit before `docker compose up -d`.
# 首次部署：cp .env.example .env && 编辑本文件。不要把 .env 提交到公开仓库。

# 宿主机根目录。会创建 data/config/logs/backup/state 五个子目录。
NODEPOOL_ROOT=/opt/nodepool

# Web UI + API 宿主端口
NODEPOOL_PORT=8080

# 镜像来源（GHCR 由 GitHub Actions 构建；也可改为本地构建的 nodepoolme:local）
NODEPOOL_IMAGE=ghcr.io/laoxuhome/nodepoolme:latest

# 管理密码（首次登录用；请修改）
NODEPOOL_ADMIN_PASSWORD=nodepool

# 会话签名密钥。请使用足够长的随机字符串。
NODEPOOL_SECRET=please-change-this-secret

# 检测引擎：mihomo（完整协议，需要镜像内内核）或 tcp（仅连通性）
NODEPOOL_TEST_ENGINE=mihomo

# 迁移入口开关。日常运行保持 0；只有停机执行
# 停机后的一次性迁移容器（见 README）执行 `run --apply` 时才临时设为 1。
NODEPOOL_MIGRATION_ENABLED=0

# 可选：覆盖容器内路径（一般不需要改）
# NODEPOOL_DATA_DIR=/data
# NODEPOOL_CONFIG_DIR=/config
# NODEPOOL_LOG_DIR=/logs
# NODEPOOL_BACKUP_DIR=/backup
# NODEPOOL_STATE_DIR=/state
# NODEPOOL_DB=/data/nodepool.db
# NODEPOOL_MIGRATION_FAULT_LOG=/state/migration-fault.log

# 可选：Mihomo 内核与端口（镜像已内置，通常无需设置）
# NODEPOOL_MIHOMO_BIN=/usr/local/bin/mihomo
# NODEPOOL_MIHOMO_API=http://127.0.0.1:9090
# NODEPOOL_MIHOMO_BASE_PORT=31000

NODEPOOL_TZ=Asia/Shanghai
