# NodePoolME environment file. Copy to .env and edit before `docker compose up -d`.

# Host directory that holds data / config / logs / backup
NODEPOOL_ROOT=/opt/nodepool

# Web UI + API port on the host
NODEPOOL_PORT=8080

# Container image (GHCR build published by GitHub Actions)
NODEPOOL_IMAGE=ghcr.io/laoxuhome/nodepoolme:latest

# Admin password for the web UI (change it!)
NODEPOOL_ADMIN_PASSWORD=nodepool

# Session signing secret. Use a long random string.
NODEPOOL_SECRET=please-change-this-secret

# Testing engine: mihomo (full protocol support) or tcp (connectivity only)
NODEPOOL_TEST_ENGINE=mihomo

TZ=Asia/Shanghai
